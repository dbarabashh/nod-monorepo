{
  "name": "@nod/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Platform-neutral data model, sync and crypto shared by the Nod apps",
  "license": "Apache-2.0",
  "author": "Dima Barabash",
  "exports": {
    "./crypto": "./src/crypto/index.ts",
    "./mcp": "./src/mcp/index.ts",
    "./meeting-detection": "./src/meeting-detection/index.ts",
    "./meetings": "./src/meetings/index.ts",
    "./meetings/testing": "./src/meetings/testing/index.ts",
    "./models": "./src/models/index.ts",
    "./sharing": "./src/sharing/index.ts",
    "./sharing/relay": "./src/sharing/relay/index.ts",
    "./sharing/testing": "./src/sharing/testing/index.ts",
    "./sync": "./src/sync/index.ts",
    "./sync/testing": "./src/sync/testing/index.ts",
    "./transcription": "./src/transcription/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "lint": "oxlint && oxfmt --check && node ../../scripts/check-no-type-assertions.ts src",
    "lint:fix": "oxlint --fix && oxfmt --write"
  },
  "dependencies": {
    "@automerge/automerge": "3.5.0",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/bip39": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
