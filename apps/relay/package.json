{
  "name": "@nod/relay",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Dima Barabash",
  "description": "The optional, self-hostable Nod sync relay: stores encrypted files it can't read",
  "type": "module",
  "exports": {
    "./server": "./server.ts"
  },
  "scripts": {
    "build": "node build.ts",
    "deploy:vercel": "node build.ts && node deploy.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"*.test.ts\" \"vercel/*.test.ts\"",
    "lint": "oxlint && oxfmt --check && node ../../scripts/check-no-type-assertions.ts .",
    "lint:fix": "oxlint --fix && oxfmt --write"
  },
  "dependencies": {
    "@nod/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
