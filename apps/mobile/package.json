{
  "name": "nod-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@automerge/automerge": "3.5.0",
    "@nod/automerge-native": "workspace:*",
    "@nod/core": "workspace:*",
    "buffer": "6.0.3",
    "expo": "~58.0.16",
    "expo-camera": "~58.0.10",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.6",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.13.0",
    "whisper.rn": "0.7.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "~19.3.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.88.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node scripts/expo.mts start",
    "ios": "node scripts/expo.mts run:ios",
    "android": "node scripts/expo.mts run:android",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "lint": "oxlint && oxfmt --check && node ../../scripts/check-no-type-assertions.ts src scripts",
    "lint:fix": "oxlint --fix && oxfmt --write"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "buildFromSource": [
        "expo-camera",
        "expo-crypto",
        "expo-secure-store"
      ]
    }
  }
}
