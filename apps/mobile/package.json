{
  "name": "nod-mobile",
  "license": "Apache-2.0",
  "author": "Dima Barabash",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@automerge/automerge": "3.5.0",
    "@expo/ui": "~58.0.26",
    "@nod/automerge-native": "workspace:*",
    "@nod/core": "workspace:*",
    "buffer": "6.0.3",
    "expo": "~58.0.22",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-widgets": "~58.0.26",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.1",
    "whisper.rn": "0.7.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "notices": "node ../../scripts/third-party-notices.ts mobile src/features/settings/third-party-notices.json",
    "start": "node scripts/expo.mts start",
    "ios": "node scripts/expo.mts run:ios",
    "android": "node scripts/expo.mts run:android",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "lint": "oxlint && oxfmt --check && node ../../scripts/check-no-type-assertions.ts src scripts",
    "lint:fix": "oxlint --fix && oxfmt --write"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "buildFromSource": [
        "expo-camera",
        "expo-crypto",
        "expo-secure-store"
      ],
      "android": {
        "exclude": [
          "expo-widgets",
          "@expo/ui"
        ]
      }
    }
  }
}
