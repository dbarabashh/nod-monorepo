{
  "expo": {
    "name": "Nod",
    "slug": "nod-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nodmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "UIDesignRequiresCompatibility": true,
        "NSLocalNetworkUsageDescription": "Nod connects to your computer on this Wi‑Fi to pair, so the key to your meetings never leaves your network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIBackgroundModes": ["audio"]
      },
      "bundleIdentifier": "com.anonymous.nod-mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E9EEF7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Nod uses the camera to scan the pairing code your computer shows, so this phone can sync your meetings.",
          "microphonePermission": "Nod listens while you record a meeting, to transcribe it on this phone. Audio is never stored.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9FAFB",
          "dark": {
            "backgroundColor": "#0C0D10"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "./plugins/with-local-pairing.js",
      "./plugins/with-no-backup.js",
      "./plugins/with-no-google-scanners.js",
      "expo-widgets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
