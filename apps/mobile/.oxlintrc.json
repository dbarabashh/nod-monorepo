{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "warn"
  },
  "ignorePatterns": ["ios/**", "android/**", ".expo/**", "dist/**"],
  "rules": {
    "import/extensions": [
      "error",
      "always",
      {
        "ignorePackages": true,
        "checkTypeImports": true
      }
    ],
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "typescript/no-non-null-assertion": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/**"],
            "message": "Use a relative import with its extension, so the file also runs under node --test."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react-native",
                  "react-native/*",
                  "react-native-*",
                  "expo",
                  "expo-*",
                  "expo/*",
                  "@expo/*",
                  "react",
                  "react/*",
                  "node:*",
                  "node:*/**",
                  "assert",
                  "buffer",
                  "child_process",
                  "crypto",
                  "events",
                  "fs",
                  "fs/promises",
                  "os",
                  "path",
                  "process",
                  "stream",
                  "url",
                  "util",
                  "worker_threads",
                  "zlib",
                  "**/app",
                  "**/app/**",
                  "**/features",
                  "**/features/**",
                  "**/components",
                  "**/components/**",
                  "**/theme",
                  "**/theme/**",
                  "**/lib",
                  "**/lib/**",
                  "@/**"
                ],
                "message": "src/core is platform-neutral and shared with the desktop app: no React, React Native, Expo, Node or other-layer imports. Take what you need through an interface implemented outside core."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/core/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react-native",
                  "react-native/*",
                  "react-native-*",
                  "expo",
                  "expo-*",
                  "expo/*",
                  "@expo/*",
                  "react",
                  "react/*",
                  "node:*",
                  "node:*/**",
                  "assert",
                  "buffer",
                  "child_process",
                  "crypto",
                  "events",
                  "fs",
                  "fs/promises",
                  "os",
                  "path",
                  "process",
                  "stream",
                  "url",
                  "util",
                  "worker_threads",
                  "zlib",
                  "**/app",
                  "**/app/**",
                  "**/features",
                  "**/features/**",
                  "**/components",
                  "**/components/**",
                  "**/theme",
                  "**/theme/**",
                  "**/lib",
                  "**/lib/**",
                  "@/**",
                  "!node:test",
                  "!node:test/**",
                  "!node:assert",
                  "!node:assert/**"
                ],
                "message": "src/core is platform-neutral and shared with the desktop app: no React, React Native, Expo, Node or other-layer imports. Take what you need through an interface implemented outside core. Tests may also import node:test and node:assert."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/**",
        "src/components/**",
        "src/theme/**",
        "src/lib/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/**", "**/app", "**/app/**", "node:*", "node:*/**"],
                "message": "Only routes in src/app import features; app code runs on Hermes without Node. Use relative imports with their extension."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/**/*.test.ts",
        "src/lib/**/*.test.ts",
        "src/theme/**/*.test.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/**",
                  "**/app",
                  "**/app/**",
                  "node:*",
                  "node:*/**",
                  "!node:test",
                  "!node:test/**",
                  "!node:assert",
                  "!node:assert/**"
                ],
                "message": "Tests import the code they cover relatively. They may import node:test and node:assert, nothing else from Node."
              }
            ]
          }
        ]
      }
    }
  ]
}
