{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "warn"
  },
  "ignorePatterns": ["ios/**", "android/**", ".expo/**", "dist/**"],
  "rules": {
    "import/extensions": [
      "error",
      "always",
      {
        "ignorePackages": true,
        "checkTypeImports": true
      }
    ],
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "typescript/no-non-null-assertion": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/**"],
            "message": "Use a relative import with its extension, so the file also runs under node --test."
          },
          {
            "group": ["**/packages/core/**", "**/apps/desktop/**"],
            "message": "Import @nod/core by its package name (@nod/core/<domain>), never through a relative path, and never import another app."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/features/**",
        "src/components/**",
        "src/theme/**",
        "src/lib/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/**", "**/app", "**/app/**", "node:*", "node:*/**"],
                "message": "Only routes in src/app import features; app code runs on Hermes without Node. Use relative imports with their extension."
              },
              {
                "group": ["**/packages/core/**", "**/apps/desktop/**"],
                "message": "Import @nod/core by its package name (@nod/core/<domain>), never through a relative path, and never import another app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/**/*.test.ts",
        "src/lib/**/*.test.ts",
        "src/theme/**/*.test.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/**",
                  "**/app",
                  "**/app/**",
                  "node:*",
                  "node:*/**",
                  "!node:test",
                  "!node:test/**",
                  "!node:assert",
                  "!node:assert/**"
                ],
                "message": "Tests import the code they cover relatively. They may import node:test and node:assert, nothing else from Node."
              },
              {
                "group": ["**/packages/core/**", "**/apps/desktop/**"],
                "message": "Import @nod/core by its package name (@nod/core/<domain>), never through a relative path, and never import another app."
              }
            ]
          }
        ]
      }
    }
  ]
}
