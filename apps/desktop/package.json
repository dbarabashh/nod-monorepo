{
  "name": "nod-desktop",
  "productName": "Nod",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Nod desktop app for macOS, Windows and Linux",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "Dima Barabash",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "node scripts/start.ts",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "node scripts/release/prepare.ts",
    "release:key": "node scripts/release/keygen.ts",
    "lint": "oxlint && oxfmt --check && node ../../scripts/check-no-type-assertions.ts src scripts forge.config.mts vite.main.config.mts vite.preload.config.mts vite.renderer.config.mts",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\""
  },
  "devDependencies": {
    "@automerge/automerge": "3.5.0",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@nod/relay": "workspace:*",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fugood/llama.node": "1.7.15",
    "@fugood/whisper.node": "1.1.3",
    "@nod/core": "workspace:*",
    "electron-squirrel-startup": "^1.0.1",
    "qr": "0.7.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
