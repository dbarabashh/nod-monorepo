{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "regions": ["fra1"],
  "functions": {
    "api/relay.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "/api/relay"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
