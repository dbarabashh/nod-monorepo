{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "warn"
  },
  "ignorePatterns": ["relay/dist/**"],
  "rules": {
    "import/extensions": [
      "error",
      "always",
      {
        "ignorePackages": true,
        "checkTypeImports": true
      }
    ],
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "typescript/no-non-null-assertion": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/packages/core/**", "**/apps/mobile/**"],
            "message": "Import @nod/core by its package name (@nod/core/<domain>), never through a relative path, and never import another app."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/renderer/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/packages/core/**",
                  "**/apps/mobile/**",
                  "electron",
                  "electron/*",
                  "node:*",
                  "node:*/**",
                  "assert",
                  "assert/strict",
                  "async_hooks",
                  "buffer",
                  "child_process",
                  "cluster",
                  "console",
                  "constants",
                  "crypto",
                  "dgram",
                  "diagnostics_channel",
                  "dns",
                  "dns/promises",
                  "domain",
                  "events",
                  "fs",
                  "fs/promises",
                  "http",
                  "http2",
                  "https",
                  "inspector",
                  "inspector/promises",
                  "module",
                  "net",
                  "os",
                  "path",
                  "path/posix",
                  "path/win32",
                  "perf_hooks",
                  "process",
                  "punycode",
                  "querystring",
                  "readline",
                  "readline/promises",
                  "repl",
                  "stream",
                  "stream/consumers",
                  "stream/promises",
                  "stream/web",
                  "string_decoder",
                  "sys",
                  "timers",
                  "timers/promises",
                  "tls",
                  "trace_events",
                  "tty",
                  "url",
                  "util",
                  "util/types",
                  "v8",
                  "vm",
                  "wasi",
                  "worker_threads",
                  "zlib",
                  "**/main",
                  "**/main/**",
                  "**/preload",
                  "**/preload/**"
                ],
                "message": "The renderer is web content: reach main only through window.api, and import contracts from src/shared."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/renderer/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/packages/core/**",
                  "**/apps/mobile/**",
                  "electron",
                  "electron/*",
                  "node:*",
                  "node:*/**",
                  "assert",
                  "assert/strict",
                  "async_hooks",
                  "buffer",
                  "child_process",
                  "cluster",
                  "console",
                  "constants",
                  "crypto",
                  "dgram",
                  "diagnostics_channel",
                  "dns",
                  "dns/promises",
                  "domain",
                  "events",
                  "fs",
                  "fs/promises",
                  "http",
                  "http2",
                  "https",
                  "inspector",
                  "inspector/promises",
                  "module",
                  "net",
                  "os",
                  "path",
                  "path/posix",
                  "path/win32",
                  "perf_hooks",
                  "process",
                  "punycode",
                  "querystring",
                  "readline",
                  "readline/promises",
                  "repl",
                  "stream",
                  "stream/consumers",
                  "stream/promises",
                  "stream/web",
                  "string_decoder",
                  "sys",
                  "timers",
                  "timers/promises",
                  "tls",
                  "trace_events",
                  "tty",
                  "url",
                  "util",
                  "util/types",
                  "v8",
                  "vm",
                  "wasi",
                  "worker_threads",
                  "zlib",
                  "**/main",
                  "**/main/**",
                  "**/preload",
                  "**/preload/**",
                  "!node:test",
                  "!node:test/**",
                  "!node:assert",
                  "!node:assert/**"
                ],
                "message": "The renderer is web content: reach main only through window.api, and import contracts from src/shared. Tests may also import node:test and node:assert."
              }
            ]
          }
        ]
      }
    }
  ]
}
