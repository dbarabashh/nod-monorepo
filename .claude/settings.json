{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hooks/format-edited-files.sh\"",
            "statusMessage": "Formatting with oxlint + oxfmt"
          }
        ]
      }
    ]
  }
}
